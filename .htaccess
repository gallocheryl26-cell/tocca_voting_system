# TOCCA public URLs and request hardening
# Share: /vote/  /register/  /track/  /vote/{business}/
# Docs: docs/HOSTING_PUBLIC_URLS.md

Options -Indexes

# Allow large file uploads on the registration form (8+ images)
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 128M
  php_value max_file_uploads 25
  php_value max_execution_time 120
  php_value max_input_time 120
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "(?i)^(config\.local\.php|config\.php|\.env|\.user\.ini|composer\.(json|lock))$">
    Require all denied
  </FilesMatch>
</IfModule>

# Long-lived cache for static assets (PageSpeed "efficient cache lifetimes")
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Production (this folder is the domain root): leave RewriteBase commented out.
  # Local XAMPP subdirectory:
  # RewriteBase /TOCCA_RECENT_NEWEST_2/

  # Block hidden/system paths (path traversal and source dumps)
  RewriteRule (^|/)\.git(/|$) - [F,L]
  RewriteRule ^(db|tests|vendor|docs)/ - [F,L]

  # Reject encoded traversal in the request
  RewriteCond %{QUERY_STRING} \.\./ [NC,OR]
  RewriteCond %{QUERY_STRING} %2e%2e [NC]
  RewriteRule ^ - [F,L]

  # Hide long PHP paths: send public pages to short URLs (not AJAX status lookups)
  RewriteCond %{QUERY_STRING} !(^|&)ajax=
  RewriteCond %{REQUEST_URI} ^/(.+)/nomination/nomination_tracking\.php$
  RewriteRule ^nomination/nomination_tracking\.php$ /%1/track [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)ajax=
  RewriteRule ^nomination/nomination_tracking\.php$ /track [R=302,L,QSA]

  RewriteCond %{REQUEST_URI} ^/(.+)/nomination/nomination_form\.php$
  RewriteRule ^nomination/nomination_form\.php$ /%1/register [R=302,L,QSA]
  RewriteRule ^nomination/nomination_form\.php$ /register [R=302,L,QSA]

  # Hide long voting PHP paths (do not expose /e-vote-final-enhanced/*.php)
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/index\.php$
  RewriteRule ^e-vote-final-enhanced/index\.php$ /%1/vote/ [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/index\.php$ /vote/ [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/thankyou\.php$
  RewriteRule ^e-vote-final-enhanced/thankyou\.php$ /%1/vote/thanks [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/thankyou\.php$ /vote/thanks [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/summarypoll\.php$
  RewriteRule ^e-vote-final-enhanced/summarypoll\.php$ /%1/vote/summary [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/summarypoll\.php$ /vote/summary [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/category\.php$
  RewriteRule ^e-vote-final-enhanced/category\.php$ /%1/vote/categories [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/category\.php$ /vote/categories [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/selected-category\.php$
  RewriteRule ^e-vote-final-enhanced/selected-category\.php$ /%1/vote/ballot [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/selected-category\.php$ /vote/ballot [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/privacy_policy\.php$
  RewriteRule ^e-vote-final-enhanced/privacy_policy\.php$ /%1/vote/privacy [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/privacy_policy\.php$ /vote/privacy [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/terms_and_conditions\.php$
  RewriteRule ^e-vote-final-enhanced/terms_and_conditions\.php$ /%1/vote/terms [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/terms_and_conditions\.php$ /vote/terms [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/message\.php$
  RewriteRule ^e-vote-final-enhanced/message\.php$ /%1/vote/message [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/message\.php$ /vote/message [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteCond %{REQUEST_URI} ^/(.+)/e-vote-final-enhanced/verification\.php$
  RewriteRule ^e-vote-final-enhanced/verification\.php$ /%1/vote/verify [R=302,L,QSA]
  RewriteCond %{QUERY_STRING} !(^|&)admin_preview=
  RewriteRule ^e-vote-final-enhanced/verification\.php$ /vote/verify [R=302,L,QSA]

  # Vanity /register used to POST relative submit_nomination.php → /submit_nomination.php (404).
  RewriteRule ^submit_nomination\.php$ nomination/submit_nomination.php [L,QSA]
  RewriteRule ^update_nomination_media\.php$ nomination/update_nomination_media.php [L,QSA]
  RewriteRule ^track/update_nomination_media\.php$ nomination/update_nomination_media.php [L,QSA]

  # Do not rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^track/?$ public_router.php?route=track [L,QSA,NC]
  RewriteRule ^register/?$ public_router.php?route=register [L,QSA,NC]

  RewriteRule ^vote/summary/?$ public_router.php?route=vote&page=summary [L,QSA,NC]
  RewriteRule ^vote/categories/?$ public_router.php?route=vote&page=categories [L,QSA,NC]
  RewriteRule ^vote/ballot/?$ public_router.php?route=vote&page=ballot [L,QSA,NC]
  RewriteRule ^vote/thanks/?$ public_router.php?route=vote&page=thanks [L,QSA,NC]
  RewriteRule ^vote/privacy/?$ public_router.php?route=vote&page=privacy [L,QSA,NC]
  RewriteRule ^vote/terms/?$ public_router.php?route=vote&page=terms [L,QSA,NC]
  RewriteRule ^vote/message/?$ public_router.php?route=vote&page=message [L,QSA,NC]
  RewriteRule ^vote/verify/?$ public_router.php?route=vote&page=verify [L,QSA,NC]
  RewriteRule ^vote/?$ public_router.php?route=vote [L,QSA,NC]

  # Business vote: /vote/{slug}  (letters, numbers, hyphens only — no path traversal)
  RewriteRule ^vote/([A-Za-z0-9\-]+)/?$ public_router.php?route=business&slug=$1 [L,QSA,NC]

  # Old /b/{slug} and /{slug} → /vote/{slug}/ so printed QRs still open
  RewriteCond %{REQUEST_URI} ^/(.+)/b/([A-Za-z0-9\-]+)/?$
  RewriteRule ^b/([A-Za-z0-9\-]+)/?$ /%1/vote/%2/ [R=301,L]
  RewriteRule ^b/([A-Za-z0-9\-]+)/?$ /vote/$1/ [R=301,L]

  RewriteCond %{REQUEST_URI} ^/(.+)/([A-Za-z0-9\-]+)/?$
  RewriteRule ^([A-Za-z0-9\-]+)/?$ /%1/vote/%2/ [R=301,L]
  RewriteRule ^([A-Za-z0-9\-]+)/?$ /vote/$1/ [R=301,L]
</IfModule>
